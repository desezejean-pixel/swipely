{
  "manifest_version": 3,
  "name": "Swipely",
  "version": "1.19.1",
  "description": "Swipe through internships and jobs that fit your CV, then track every application.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this offer to Swipely",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting", "alarms", "notifications", "offscreen"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://jobs.stationf.co/*",
    "https://venturecapitalcareers.com/*",
    "https://www.jobteaser.com/*",
    "https://www.google.com/*",
    "https://www.amazon.jobs/*",
    "https://jobs.apple.com/*",
    "https://careers.salesforce.com/*",
    "https://www.salesforce.com/*",
    "https://nvidia.wd5.myworkdayjobs.com/*",
    "https://stripe.com/*",
    "https://api.lever.co/*",
    "https://jobs.lever.co/*",
    "https://boards-api.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://api.ashbyhq.com/*",
    "https://jobs.ashbyhq.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the internship on this page"
    }
  }
}
